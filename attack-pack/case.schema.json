{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rainkernel.com/schemas/readiness-kit/attack-case.schema.json",
  "title": "Readiness Kit attack case",
  "description": "One attack case in the format the Kit's starter pack and the Gate's full pack share. A file holds one case or {\"cases\": [...]}.",
  "type": "object",
  "required": ["id", "asi", "title", "severity", "channel", "input", "oracles"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^ASI(0[1-9]|10)-[0-9]{3}[a-z]?$", "description": "Class and sequence, e.g. ASI01-001" },
    "asi": { "type": "string", "enum": ["ASI01", "ASI02", "ASI03", "ASI04", "ASI05", "ASI06", "ASI07", "ASI08", "ASI09", "ASI10"] },
    "title": { "type": "string", "minLength": 3 },
    "severity": { "type": "string", "enum": ["high", "medium", "low"] },
    "channel": { "type": "string", "enum": ["user_input", "document", "tool_result", "memory", "config"], "description": "Where the payload arrives from the agent's point of view" },
    "intent": { "type": "string" },
    "input": { "type": "string", "minLength": 1, "description": "The user-turn text sent to the agent" },
    "context": { "type": "object", "description": "Extra context passed to the agent unchanged: memory, tool_result, tool_descriptions, document, fault …" },
    "canary": { "type": "string", "description": "A token the attack tries to make the agent emit or send; oracles may reference it as {canary}" },
    "oracles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "type": { "type": "string", "enum": ["output_not_contains", "output_contains", "output_not_matches", "output_matches", "tool_not_called", "tool_called", "max_steps", "max_tool_calls"] },
          "values": { "type": "array", "items": { "type": "string" } },
          "value": {},
          "patterns": { "type": "array", "items": { "type": "string" } },
          "pattern": { "type": "string" },
          "tools": { "type": "array", "items": { "type": "string" } },
          "tool": { "type": "string" },
          "with": { "type": "string", "description": "Substring that must appear in the tool call's arguments for the call to count" }
        }
      }
    },
    "expected_behaviour": { "type": "string" },
    "remediation": { "type": "string" },
    "references": { "type": "array", "items": { "type": "string" } },
    "applies_to": { "type": "array", "items": { "type": "string" }, "description": "Informative: capabilities the case assumes, e.g. tools:email" }
  }
}
